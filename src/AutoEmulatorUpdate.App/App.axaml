<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoEmulatorUpdate.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AutoEmulatorUpdate.App/Styles/AppStyles.axaml" />
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://AutoEmulatorUpdate.App/Assets/app-icon.ico" />
    </Style>
  </Application.Styles>
</Application>
