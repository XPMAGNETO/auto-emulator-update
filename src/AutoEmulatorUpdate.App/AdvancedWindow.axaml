<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoEmulatorUpdate.App.AdvancedWindow"
        Width="1100" Height="720"
        Title="Auto Emulator Update — Advanced">
  <TabControl Margin="12">
    <TabItem Header="Health">
      <DataGrid ItemsSource="{Binding Installed}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Emulator" Binding="{Binding Definition.Name}" Width="160"/>
          <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="220"/>
          <DataGridTextColumn Header="Health" Binding="{Binding SourceHealth}" Width="110"/>
          <DataGridTextColumn Header="Detection" Binding="{Binding DetectionMethod}" Width="180"/>
          <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100"/>
          <DataGridTextColumn Header="Portable" Binding="{Binding IsPortable}" Width="90"/>
          <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="110"/>
        </DataGrid.Columns>
      </DataGrid>
    </TabItem>
    <TabItem Header="Why wasn't this found?">
      <Grid Margin="12" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="Run a diagnostic discovery scan to see which roots were searched, expected executable/package names, skipped or inaccessible paths, duplicate suppression, frontend detection attempts, manifests considered, and why an emulator was not detected. Paths under your user profile are sanitized before display or export."/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,10">
          <Button Content="RUN DISCOVERY DIAGNOSTICS" Click="RunDiscoveryDiagnostics_Click"/>
          <Button Content="COPY SANITIZED REPORT" Click="CopyDiscoveryDiagnostics_Click"/>
          <Button Content="EXPORT SANITIZED REPORT" Click="ExportDiscoveryDiagnostics_Click"/>
          <TextBlock x:Name="DiscoveryStatus" VerticalAlignment="Center" Opacity="0.75"/>
        </StackPanel>
        <TextBox x:Name="DiscoveryText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontFamily="Monospace"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Grid>
    </TabItem>
    <TabItem Header="Raw log">
      <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </TabItem>
    <TabItem Header="About manifests">
      <ScrollViewer>
        <TextBlock Margin="18" TextWrapping="Wrap"
                   Text="Emulator support is manifest-driven. Bundled manifests live with the application; user/community manifests are loaded from the application data directory. This screen is intentionally separate from the normal workflow so regular users do not need to manage JSON files."/>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
