<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoEmulatorUpdate.Mobile.MainView">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
    <Border Padding="18,14" Background="#151A22">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Auto Emulator Updater" FontSize="21" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Mobile Companion" Foreground="#AEB9CA" />
        </StackPanel>
        <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="#263142" VerticalAlignment="Center">
          <TextBlock Text="{Binding ConnectionLabel}" Foreground="White" />
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Home">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="14">
            <Border Classes="card" IsVisible="{Binding IsPairingRequired}">
              <StackPanel Spacing="10">
                <TextBlock Text="Pair with your computer" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Enter the address and one-time code displayed by Auto Emulator Updater on your computer." TextWrapping="Wrap" />
                <TextBox PlaceholderText="Paste the complete desktop pairing address" Text="{Binding DesktopAddress}" />
                <TextBox PlaceholderText="Pairing code" Text="{Binding PairingCode}" />
                <Button Classes="primary accent" Content="Pair securely" Command="{Binding PairCommand}" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#D94B4B" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding IsPaired}" Spacing="14">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="card">
                  <StackPanel>
                    <TextBlock Text="Installed" Opacity="0.7" />
                    <TextBlock Text="{Binding Snapshot.InstalledCount}" FontSize="28" FontWeight="Bold" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                  <StackPanel>
                    <TextBlock Text="Updates" Opacity="0.7" />
                    <TextBlock Text="{Binding Snapshot.UpdateCount}" FontSize="28" FontWeight="Bold" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Desktop status" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Snapshot.StatusMessage}" TextWrapping="Wrap" />
                  <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
              </Border>
              <Button Classes="primary accent" Content="Check all emulators" Command="{Binding CheckAllCommand}" />
              <Button Classes="primary" Content="Install available updates" Command="{Binding UpdateAllCommand}" IsEnabled="{Binding CanInstallUpdates}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Emulators">
        <ScrollViewer>
          <ItemsControl Margin="16" ItemsSource="{Binding Snapshot.Emulators}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding VersionSummary}" Opacity="0.75" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Activity">
        <ScrollViewer>
          <ItemsControl Margin="16" ItemsSource="{Binding Snapshot.Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TimestampLabel}" FontSize="12" Opacity="0.65" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
